# Cloudflare Pages — _headers
# Aplicado a todas as rotas. Conservador: não quebra a SPA existente.

/*
  # Impede que o site seja carregado em iframe (proteção contra clickjacking)
  X-Frame-Options: DENY

  # Impede que o browser "adivinhe" o tipo de conteúdo (MIME sniffing)
  X-Content-Type-Options: nosniff

  # Envia o referrer só para a mesma origem, sem vazar para terceiros
  Referrer-Policy: strict-origin-when-cross-origin

  # Restringe o que APIs do browser podem fazer (sem câmera, microfone, geolocalização)
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

  # Força HTTPS por 1 ano (só ativa em produção com HTTPS real)
  Strict-Transport-Security: max-age=31536000; includeSubDomains

  # Content Security Policy — permite:
  # - scripts: mesmo site + eval necessário para o Vite/PWA buildado
  # - estilos: mesmo site + inline (necessário para CSS-in-JS do React)
  # - conexões: Supabase (banco+auth) + Google Fonts API
  # - imagens: mesmo site + data URIs (avatares em base64)
  # - frames: nenhum (DENY acima reforça)
  # NOTA: ajuste supabase host se mudar de projeto
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.anthropic.com; img-src 'self' data: blob:; font-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'

# Assets estáticos — cache longo (hash no nome garante que mudam quando o conteúdo muda)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Service worker e manifest — sem cache (devem estar sempre frescos)
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.webmanifest
  Cache-Control: no-cache
